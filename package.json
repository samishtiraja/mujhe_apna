{
  "name": "websongcreate",
  "homepage": "https://samishtiraja.github.io/mujhe_apna/",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "predeploy": "npm run build",
    "deploy": "gh-pages-clean && gh-pages -d dist --no-history --dotfiles",
    "lint": "oxlint",
    "preview": "vite preview",
    "export-video": "node scripts/exportVideo.js",
    "export-4k": "node scripts/exportVideo.js --4k",
    "export-full": "node scripts/exportVideo.js --duration full --output song_full_video.mp4",
    "process-radha": "node scripts/processRadhaCast.js",
    "process-krishna": "node scripts/processKrishnaCast.js",
    "process-all-cast": "node scripts/processRadhaCast.js && node scripts/processKrishnaCast.js",
    "clean-cast": "node scripts/cleanCastImages.js"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simplex-noise": "^4.0.3",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.89.0",
    "puppeteer-core": "^25.16.0",
    "vite": "^8.3.5"
  }
}
